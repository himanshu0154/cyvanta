# Configuration reference: export these variables in the Flask server process.
# No real secrets belong in this file. See docs/incident-intelligence.md.
AI_ENABLED=true
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
# Optional HTTPS OpenAI-compatible API root, including /v1; blank uses OpenAI.
AI_BASE_URL=
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# Optional deterministic correlation settings. Never assume a traffic timezone.
CORRELATION_WINDOW_SECONDS=300
TRAFFIC_TIMEZONE=
TRAFFIC_TIMESTAMP_FORMAT=
# Optional operator-managed signing secret; blank uses ignored instance/session-secret.
CYVANTA_SESSION_SECRET=
