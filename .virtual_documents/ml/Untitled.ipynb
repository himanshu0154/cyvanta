result.head()


from sklearn.metrics import classification_report, confusion_matrix

y_true = result["Label"].str.strip().map({
    "BENIGN": "Normal",
    "DDoS": "Anomaly"
})

print(confusion_matrix(y_true, result["prediction"]))
print(classification_report(y_true, result["prediction"]))


